rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // AVATARS: chat avatar (<uid>_...) and creator avatar (creator_<uid>_...)
    match /avatars/{fileName} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && (fileName.split('_')[0] == request.auth.uid
            || (fileName.split('_')[0] == 'creator' && fileName.split('_')[1] == request.auth.uid))
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null
        && (fileName.split('_')[0] == request.auth.uid
            || (fileName.split('_')[0] == 'creator' && fileName.split('_')[1] == request.auth.uid));
    }

    // CHAT MEDIA and STORIES: images, videos, voice notes, documents
    match /media/{uid}/{assetId} {
      allow get: if request.auth != null;
      allow delete: if owner(uid);
      allow create: if resource == null
        && owner(uid)
        && assetId.size() <= 100
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          '(image/(jpeg|png|webp|gif)|video/(mp4|webm|quicktime)|audio/(webm|ogg|wav|mpeg|mp4|x-m4a)(;codecs=[a-zA-Z0-9.-]+)?|application/(octet-stream|pdf|msword|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|vnd[.]ms-excel|vnd[.]openxmlformats-officedocument[.]spreadsheetml[.]sheet|vnd[.]ms-powerpoint|vnd[.]openxmlformats-officedocument[.]presentationml[.]presentation|zip|x-zip-compressed)|text/(plain|csv))'
        );
    }

    // REELS: video + thumbnail (up to 200 MB)
    match /reels/{userId}/{allPaths=**} {
      allow get: if request.auth != null;
      allow create, update: if owner(userId)
        && request.resource.size > 0
        && request.resource.size <= 200 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('image/.*'));
      allow delete: if owner(userId);
    }

    // COMMUNITY: post images, group covers
    match /community/{uid}/{assetId} {
      allow get: if request.auth != null;
      allow create: if owner(uid)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if owner(uid);
    }

    // CALL RECORDINGS
    match /call_recordings/{fileName} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*|video/.*');
    }
  }
}
